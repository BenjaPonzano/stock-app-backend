# Copiar este archivo como .env y completar los valores.
# El .env real no se commitea (está en .gitignore).

# Puerto donde escucha la API.
# Importante: NO usar 3000, que es el que ocupa el frontend de React.
PORT=3001

# Conexión a MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=stock_app
DB_USER=root
DB_PASSWORD=

# Clave para firmar y validar los JWT del login.
# Sin esta variable el login devuelve 500 y las rutas protegidas devuelven 401.
# Generar una propia con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
